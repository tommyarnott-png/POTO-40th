{
  "name": "poto-40th",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Assets get first refusal, and the SPA fallback answers anything that misses
    // with index.html and a 200. Without this the signup POST would be handed the
    // page's HTML instead of reaching the Worker at all.
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "poto-40th-downloads"
    }
  ],
  "ratelimits": [
    {
      // Ten submissions a minute from one address, keyed on the whole address, not
      // the /24 the token is bound to: a shared office address would otherwise run
      // one bucket between everyone behind it.
      //
      // Ten rather than five because the counter is per Cloudflare edge machine and
      // never was a global cap — anyone scripting this gets a fresh budget on a new
      // connection, so the ceiling only ever stopped the laziest abuse, and five was
      // close enough to real use to catch someone unlucky. A visitor needs one
      // submission per download, another if they mistype an address, and another if
      // they moved networks and had to press again. Ten leaves room for all of that
      // and still refuses anything a person could do by hand. The period may only be
      // 10 or 60.
      "name": "SIGNUP_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
