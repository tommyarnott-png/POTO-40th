node_modules/
dist/
.DS_Store
*.local
.env
.env.*
!.env.example
# Worker secrets for `wrangler dev`. Never committed.
.dev.vars
.dev.vars.*

# Full-resolution source audio is never committed: the grouped-stem archive
# alone is 220MB, past GitHub's 100MB per-file limit. See docs/ASSETS.md.
*.wav
*.aiff
*.flac
public/audio/source/
GroupedStems-ForWebsite.zip

# Only the images the page uses are committed: the production wordmark, the
# release packshots and the page background, plus the A/B masks the packshots
# replaced, which are kept though nothing renders them. See docs/ASSETS.md.
public/images/*
!public/images/.gitkeep
!public/images/phantom-wordmark-white.avif
!public/images/phantom-wordmark-white.png
!public/images/packshot-*.avif
!public/images/packshot-*.jpg
!public/images/mask-original.png
!public/images/mask-remaster.png
!public/images/smoke-bg.jpg

# Wrangler's local state.
.wrangler/
