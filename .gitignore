# Full-resolution source audio is never committed: the grouped-stem archive
# alone is 220MB, past GitHub's 100MB per-file limit. See docs/ASSETS.md.
*.wav
*.aiff
*.flac
public/audio/source/
GroupedStems-ForWebsite.zip

# The official production logo is not redistributed here; the A/B masks and the
# page background are. See docs/ASSETS.md.
public/images/*
!public/images/.gitkeep
!public/images/mask-original.png
!public/images/mask-remaster.png
!public/images/smoke-bg.jpg

# Wrangler's local state.
.wrangler/
